# ── diptype: единый пример переменных окружения ──
# Скопируйте в server/.env (и при необходимости в client/.env)

# Сервер
PORT=4000
NODE_ENV=development
# Секрет для подписи JWT (обязательно смените в проде)
JWT_SECRET=change-me-to-a-long-random-string
# Источник, которому разрешён CORS (фронтенд)
CLIENT_ORIGIN=http://localhost:5173

# Anthropic API — без ключа сервер работает в demo-режиме (моковая генерация)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# YooMoney — без credentials кнопки оплаты работают в demo-режиме
YOOMONEY_SHOP_ID=
YOOMONEY_SECRET_KEY=
YOOMONEY_RETURN_URL=http://localhost:5173/dashboard

# Оплата криптовалютой TON — без TON_WALLET_ADDRESS работает в demo-режиме
TON_WALLET_ADDRESS=
TONCENTER_BASE=https://toncenter.com/api/v2
TONCENTER_API_KEY=
TON_RUB_RATE=350

# GitHub (опционально) — токен для загрузки сгенерированных файлов в репозиторий пользователя
GITHUB_TOKEN=

# Бесплатный лимит запросов
FREE_REQUEST_LIMIT=3
